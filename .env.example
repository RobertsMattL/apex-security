# Copy to .env (gitignored). Real environment variables override this file.

# HTTP API + WebSocket
# PORT=8780
# Host/IP the phone uses to reach this machine (used in RTSP URLs handed to clients).
# Defaults to the host name the client used for the API request.
# PUBLIC_HOST=192.168.1.20
# Optional TLS for the API/WebSocket:
# TLS_CERT=/path/cert.pem
# TLS_KEY=/path/key.pem

# MediaMTX (tacticalRtsp's streaming server), started and managed by this server
# Defaults avoid tacticalRtsp's own MediaMTX (8554/8000/9997) so both can run side by side.
# RTSP_PORT=8564
# RTP_PORT=8010
# MEDIAMTX_API_PORT=9987

# Detection sidecar: tacticalRtsp's YOLO venv and weights.
# The submodule has no venv; point at an existing tacticalRtsp checkout's venv, or create one:
#   python3 -m venv vendor/tacticalRtsp/yolo/.venv && vendor/tacticalRtsp/yolo/.venv/bin/pip install -r vendor/tacticalRtsp/yolo/requirements.txt
DETECTOR_PYTHON=/Volumes/LaCie/tacticalRtsp/yolo/.venv/bin/python
DETECTOR_MODEL=/Volumes/LaCie/tacticalRtsp/yolo/yolo11s.pt
# DETECTOR_IMGSZ=1280
# DETECTOR_FPS=5
# DETECTOR_DEVICE=mps
# DETECTOR_ENABLED=true
